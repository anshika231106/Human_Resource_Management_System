# Copy to backend/.env — every value below is parsed through Zod at boot in
# src/config/env.ts, so a missing or malformed variable fails loudly on startup
# instead of surfacing as a mystery 500 later.

NODE_ENV=development
PORT=4000

# Matches docker-compose.yml. Note port 5434, not 5432 — see the comment at the
# top of docker-compose.yml for why.
DATABASE_URL="postgresql://dayflow:dayflow@localhost:5434/dayflow?schema=public"

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-secret-change-me-before-you-ever-deploy-this"
JWT_EXPIRES_IN=12h

# Comma-separated allowlist. Cookies are only sent to origins listed here.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Every calendar decision goes through this zone, never the client's clock.
APP_TIMEZONE=Asia/Kolkata

# Below the threshold a completed day is a HALF_DAY, at or above it is PRESENT.
FULL_DAY_MINUTES=240

# MailHog, for BE1's verification mail.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Dayflow <no-reply@dayflow.local>"
